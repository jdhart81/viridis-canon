+def terminal_premise_work_item(path: Path, certificate_root: Path) -> WorkItem | None:
+    from verification_coverage_gates.terminal_certification.terminal_hold import terminal_hold
+    evidence = terminal_hold(path, certificate_root)
+    if evidence is None:
+        return None
+    return WorkItem(path.name, "TERMINAL_PREMISE_HOLD",
+                    "PRESERVE_SEALED_OBJECT_AWAIT_REVIEWED_SUCCESSOR", True,
+                    "Exact reviewed terminal premise HOLD; do not resubmit this sealed object. "
+                    "Certification debt and publication admission remain unchanged. Receipt SHA-256: "
+                    + evidence["receipt_sha256"])
