{
  "$id": "https://jdhart81.github.io/viridis-canon/schemas/research-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "concept_doi": {
      "type": "string"
    },
    "honesty_notice": {
      "minLength": 1,
      "type": "string"
    },
    "human_publish_gate": {
      "const": true
    },
    "publication_scope": {
      "enum": [
        "public",
        "workspace"
      ]
    },
    "records": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "abstract": {
            "minLength": 1,
            "type": "string"
          },
          "caveat": {
            "type": "string"
          },
          "digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "paper_url": {
            "anyOf": [
              {
                "pattern": "^https://",
                "type": "string"
              },
              {
                "const": ""
              }
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "pattern": "^https://",
                "type": "string"
              },
              {
                "const": ""
              }
            ]
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "working",
              "quarantined"
            ]
          },
          "tier": {
            "enum": [
              "spine",
              "flagship",
              "working-corpus"
            ]
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          }
        },
        "required": [
          "record_id",
          "title",
          "abstract",
          "path",
          "source_url",
          "paper_url",
          "status",
          "tier",
          "visibility",
          "source_sha256",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "release": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "schema": {
      "const": "https://jdhart81.github.io/viridis-canon/schemas/research-catalog-v1.json"
    },
    "stats": {
      "type": "object"
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim_scope": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$"
          },
          "disclaimer": {
            "const": "logical validity given the model, not empirical validation of its assumptions"
          },
          "public_readback_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "publication_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "certificate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "certificate_sha256",
          "claim_scope",
          "disclaimer",
          "doi",
          "entity_id",
          "public_readback_sha256",
          "publication_binding_sha256",
          "record_id",
          "title"
        ]
      }
    },
    "methods_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^publication:methods-digest:[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]):[1-9][0-9]*$"
          },
          "record_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "doi": {
            "type": "string",
            "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$"
          },
          "release_week": {
            "type": "string",
            "pattern": "^[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3])$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "certifies": {
            "const": false
          },
          "disclaimer": {
            "const": "logical validity given the model, not empirical validation of its assumptions"
          },
          "registration_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "public_readback_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "publication_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entity_id": {
                  "type": "string",
                  "pattern": "^publication:methods-note:[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]):Run-[0-9]{3,}$"
                },
                "run_id": {
                  "type": "string",
                  "pattern": "^Run-[0-9]{3,}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "claim_scope": {
                  "type": "string",
                  "minLength": 1
                },
                "foundation_basis": {
                  "enum": [
                    "INDEPENDENT",
                    "THEOREM",
                    "CONDITIONAL_PL_PD"
                  ]
                },
                "certifies": {
                  "const": "LISTED_NOTE_SCOPE_ONLY"
                },
                "disclaimer": {
                  "const": "logical validity given the model, not empirical validation of its assumptions"
                },
                "certificate_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "publication_binding_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "semantic_labels": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "lean_theorem": {
                        "type": "string",
                        "minLength": 1
                      },
                      "semantic_tier": {
                        "enum": [
                          "DEFINITIONAL",
                          "ROUTINE",
                          "SUBSTANTIVE",
                          "UNCLASSIFIED",
                          "DEPTH_NOT_ASSESSED"
                        ]
                      },
                      "nonvacuity_label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "headline_eligible": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "lean_theorem",
                      "semantic_tier",
                      "nonvacuity_label",
                      "headline_eligible"
                    ]
                  }
                }
              },
              "required": [
                "certificate_sha256",
                "certifies",
                "claim_scope",
                "disclaimer",
                "entity_id",
                "foundation_basis",
                "publication_binding_sha256",
                "run_id",
                "semantic_labels",
                "title"
              ]
            }
          }
        },
        "required": [
          "certifies",
          "disclaimer",
          "doi",
          "entity_id",
          "notes",
          "public_readback_sha256",
          "publication_binding_sha256",
          "record_id",
          "registration_receipt_sha256",
          "release_week",
          "title"
        ]
      }
    }
  },
  "required": [
    "schema",
    "publication_scope",
    "release",
    "concept_doi",
    "repository",
    "honesty_notice",
    "human_publish_gate",
    "stats",
    "records",
    "catalog_digest",
    "publications",
    "methods_digests"
  ],
  "title": "Viridis research catalog v1",
  "type": "object"
}
