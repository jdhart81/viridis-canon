{
  "$id": "https://jdhart81.github.io/viridis-canon/schemas/research-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "concept_doi": {
      "type": "string"
    },
    "coverage_provenance": {
      "additionalProperties": false,
      "properties": {
        "certifies": {
          "const": false
        },
        "current_entities": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entity_id": {
                "minLength": 1,
                "type": "string"
              },
              "entity_type": {
                "enum": [
                  "METHODS_DIGEST_GROUP",
                  "METHODS_DIGEST_NOTE"
                ]
              },
              "row_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "snapshot_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "entity_id",
              "entity_type",
              "row_sha256",
              "snapshot_sha256"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "current_snapshots": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "pattern": "^[^/\\\\:]+$",
                "type": "string"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "sha256"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "historical_publication_entity_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "historical_record_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "historical_snapshot": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "minLength": 1,
              "pattern": "^[^/\\\\:]+$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "name",
            "sha256"
          ],
          "type": "object"
        },
        "source_prefix": {
          "const": "viridis-canon"
        },
        "standard": {
          "const": "CATALOG_COVERAGE_PROVENANCE_1"
        }
      },
      "required": [
        "standard",
        "historical_snapshot",
        "current_snapshots",
        "source_prefix",
        "historical_record_ids",
        "historical_publication_entity_ids",
        "current_entities",
        "certifies"
      ],
      "type": "object"
    },
    "honesty_notice": {
      "minLength": 1,
      "type": "string"
    },
    "human_publish_gate": {
      "const": true
    },
    "manuscript_access": {
      "additionalProperties": false,
      "properties": {
        "certifies": {
          "const": false
        },
        "correction_overlay_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "linked_paper_entries": {
          "minimum": 0,
          "type": "integer"
        },
        "mapping_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "scope": {
          "const": "explicit_publications_and_individual_methods_notes_only"
        },
        "source_index_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "status": {
          "enum": [
            "HOLD_UNRESOLVED_MANUSCRIPTS",
            "MAPPED_PUBLIC_PAPER_ENTRIES"
          ]
        },
        "unresolved": {
          "items": {
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "status",
        "certifies",
        "mapping_sha256",
        "source_index_sha256",
        "correction_overlay_sha256",
        "linked_paper_entries",
        "unresolved",
        "scope"
      ],
      "type": "object"
    },
    "methods_digests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "certifies": {
            "const": false
          },
          "disclaimer": {
            "const": "logical validity given the model, not empirical validation of its assumptions"
          },
          "doi": {
            "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$",
            "type": "string"
          },
          "entity_id": {
            "pattern": "^publication:methods-digest:[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]):[1-9][0-9]*$",
            "type": "string"
          },
          "notes": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "certificate_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "certifies": {
                  "const": "LISTED_NOTE_SCOPE_ONLY"
                },
                "claim_scope": {
                  "minLength": 1,
                  "type": "string"
                },
                "disclaimer": {
                  "const": "logical validity given the model, not empirical validation of its assumptions"
                },
                "entity_id": {
                  "pattern": "^publication:methods-note:[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3]):Run-[0-9]{3,}$",
                  "type": "string"
                },
                "foundation_basis": {
                  "enum": [
                    "INDEPENDENT",
                    "THEOREM",
                    "CONDITIONAL_PL_PD"
                  ]
                },
                "pdf_access": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "certifies": {
                          "const": false
                        },
                        "reason": {
                          "minLength": 1,
                          "type": "string"
                        },
                        "status": {
                          "const": "HOLD_UNRESOLVED_MAPPING"
                        }
                      },
                      "required": [
                        "status",
                        "certifies",
                        "reason"
                      ]
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "bytes": {
                          "minimum": 1,
                          "type": "integer"
                        },
                        "certifies": {
                          "const": false
                        },
                        "filename": {
                          "pattern": "^[^/\\\\]+\\.[pP][dD][fF]$",
                          "type": "string"
                        },
                        "index_row_sha256": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string"
                        },
                        "md5": {
                          "pattern": "^[a-f0-9]{32}$",
                          "type": "string"
                        },
                        "sha256": {
                          "pattern": "^[a-f0-9]{64}$",
                          "type": "string"
                        },
                        "status": {
                          "const": "LINKED_FROM_HASH_BOUND_PUBLIC_READBACK"
                        },
                        "verification_receipt_sha256": {
                          "items": {
                            "pattern": "^[a-f0-9]{64}$",
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        }
                      },
                      "required": [
                        "status",
                        "certifies",
                        "filename",
                        "sha256",
                        "md5",
                        "bytes",
                        "index_row_sha256",
                        "verification_receipt_sha256"
                      ]
                    }
                  ],
                  "type": "object"
                },
                "pdf_url": {
                  "pattern": "^https://zenodo\\.org/records/[1-9][0-9]*/files/[^?#]+\\.[pP][dD][fF]$",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "publication_binding_sha256": {
                  "pattern": "^[0-9a-f]{64}$",
                  "type": "string"
                },
                "run_id": {
                  "pattern": "^Run-[0-9]{3,}$",
                  "type": "string"
                },
                "semantic_labels": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "headline_eligible": {
                        "type": "boolean"
                      },
                      "lean_theorem": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "nonvacuity_label": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "semantic_tier": {
                        "enum": [
                          "DEFINITIONAL",
                          "ROUTINE",
                          "SUBSTANTIVE",
                          "UNCLASSIFIED",
                          "DEPTH_NOT_ASSESSED"
                        ]
                      }
                    },
                    "required": [
                      "lean_theorem",
                      "semantic_tier",
                      "nonvacuity_label",
                      "headline_eligible"
                    ],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "title": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "certificate_sha256",
                "certifies",
                "claim_scope",
                "disclaimer",
                "entity_id",
                "foundation_basis",
                "publication_binding_sha256",
                "run_id",
                "semantic_labels",
                "title"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "public_readback_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "publication_binding_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "record_id": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "registration_receipt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "release_week": {
            "pattern": "^[0-9]{4}-W(?:0[1-9]|[1-4][0-9]|5[0-3])$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "certifies",
          "disclaimer",
          "doi",
          "entity_id",
          "notes",
          "public_readback_sha256",
          "publication_binding_sha256",
          "record_id",
          "registration_receipt_sha256",
          "release_week",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "publication_scope": {
      "enum": [
        "public",
        "workspace"
      ]
    },
    "publications": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "certificate_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "claim_scope": {
            "minLength": 1,
            "type": "string"
          },
          "disclaimer": {
            "const": "logical validity given the model, not empirical validation of its assumptions"
          },
          "doi": {
            "pattern": "^10\\.5281/zenodo\\.[1-9][0-9]*$",
            "type": "string"
          },
          "entity_id": {
            "minLength": 1,
            "type": "string"
          },
          "pdf_access": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "certifies": {
                    "const": false
                  },
                  "reason": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "status": {
                    "const": "HOLD_UNRESOLVED_MAPPING"
                  }
                },
                "required": [
                  "status",
                  "certifies",
                  "reason"
                ]
              },
              {
                "additionalProperties": false,
                "properties": {
                  "bytes": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "certifies": {
                    "const": false
                  },
                  "filename": {
                    "pattern": "^[^/\\\\]+\\.[pP][dD][fF]$",
                    "type": "string"
                  },
                  "index_row_sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "md5": {
                    "pattern": "^[a-f0-9]{32}$",
                    "type": "string"
                  },
                  "sha256": {
                    "pattern": "^[a-f0-9]{64}$",
                    "type": "string"
                  },
                  "status": {
                    "const": "LINKED_FROM_HASH_BOUND_PUBLIC_READBACK"
                  },
                  "verification_receipt_sha256": {
                    "items": {
                      "pattern": "^[a-f0-9]{64}$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  }
                },
                "required": [
                  "status",
                  "certifies",
                  "filename",
                  "sha256",
                  "md5",
                  "bytes",
                  "index_row_sha256",
                  "verification_receipt_sha256"
                ]
              }
            ],
            "type": "object"
          },
          "pdf_url": {
            "pattern": "^https://zenodo\\.org/records/[1-9][0-9]*/files/[^?#]+\\.[pP][dD][fF]$",
            "type": [
              "string",
              "null"
            ]
          },
          "public_readback_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "publication_binding_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "record_id": {
            "pattern": "^[1-9][0-9]*$",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "certificate_sha256",
          "claim_scope",
          "disclaimer",
          "doi",
          "entity_id",
          "public_readback_sha256",
          "publication_binding_sha256",
          "record_id",
          "title"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "records": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "abstract": {
            "minLength": 1,
            "type": "string"
          },
          "caveat": {
            "type": "string"
          },
          "digest": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "paper_url": {
            "anyOf": [
              {
                "pattern": "^https://",
                "type": "string"
              },
              {
                "const": ""
              }
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_id": {
            "minLength": 1,
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "source_url": {
            "anyOf": [
              {
                "pattern": "^https://",
                "type": "string"
              },
              {
                "const": ""
              }
            ]
          },
          "status": {
            "enum": [
              "verified",
              "working",
              "quarantined"
            ]
          },
          "tier": {
            "enum": [
              "spine",
              "flagship",
              "working-corpus"
            ]
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          }
        },
        "required": [
          "record_id",
          "title",
          "abstract",
          "path",
          "source_url",
          "paper_url",
          "status",
          "tier",
          "visibility",
          "source_sha256",
          "digest"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "release": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "schema": {
      "const": "https://jdhart81.github.io/viridis-canon/schemas/research-catalog-v1.json"
    },
    "stats": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "publication_scope",
    "release",
    "concept_doi",
    "repository",
    "honesty_notice",
    "human_publish_gate",
    "stats",
    "records",
    "catalog_digest",
    "publications",
    "methods_digests"
  ],
  "title": "Viridis research catalog v1",
  "type": "object"
}
