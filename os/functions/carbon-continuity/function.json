  "inputs": [
    {
      "name": "a",
      "required": true,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "type": "number",
      "unit": "dimensionless retention coefficient",
      "help": "Retention coefficient — share of carbon retained after the fire (0–1)."
    },
    {
      "name": "d",
      "required": true,
      "exclusiveMaximum": 1,
      "minimum": 0,
      "type": "number",
      "unit": "dimensionless retention coefficient",
