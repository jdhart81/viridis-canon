    },
    {
      "name": "r",
      "required": true,
      "exclusiveMinimum": 0,
      "type": "number",
      "unit": "dimensionless coupling coefficient",
      "help": "Regrowth rate coefficient (0–1)."
    },
    {
      "name": "p",
      "required": true,
      "exclusiveMinimum": 0,
      "type": "number",
      "unit": "dimensionless coupling coefficient",
      "help": "Regenerative coupling — how strongly surviving stock supports regrowth (0–1)."
    }
  ],
