  "hypotheses": [
    {
      "id": "retention_living",
      "statement": "Living retention a lies in [0, 1).",
      "check": "0 <= a < 1"
    },
    {
      "id": "retention_durable",
      "statement": "Durable retention d lies in [0, 1).",
      "check": "0 <= d < 1"
    },
    {
      "id": "coupling_positive",
      "statement": "Both coupling coefficients r and p are positive.",
      "check": "r > 0 and p > 0"
    }
  ],
