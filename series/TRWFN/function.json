  "inputs": [
    {
      "name": "budget_usd",
      "required": true,
      "minimum": 0,
      "type": "number",
      "unit": "USD",
      "help": "Total capital available (USD)."
    },
    {
      "name": "declared_evidence_ready",
      "required": true,
      "type": "boolean",
      "unit": "bool",
      "help": "Whether the declared values rest on authorized evidence (true/false)."
    },
    {
      "name": "declared_price_authorized",
      "required": true,
      "type": "boolean",
      "unit": "bool",
      "help": "Whether the declared prices are authorized (true/false)."
    },
    {
      "name": "assets",
      "required": true,
      "items": {
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "capital_cost_usd": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "embodied_transition_cost_usd": {
            "minimum": 0,
            "type": "number"
          },
          "gross_avoided_value_usd": {
            "minimum": 0,
            "type": "number"
          },
          "transition_friction_usd": {
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "asset_id",
          "gross_avoided_value_usd",
          "embodied_transition_cost_usd",
          "capital_cost_usd",
          "transition_friction_usd"
        ],
        "type": "object"
      },
      "maxItems": 25,
      "minItems": 1,
      "type": "array",
      "unit": "list of declared alternatives (USD fields)",
      "help": "Candidate assets with declared value and cost fields, as a list."
    }
  ],
  "outputs": [
    {
      "name": "allocation_status"
    },
    {
      "name": "budget_shadow_price",
      "unit": "dimensionless USD-objective per USD-budget"
    },
    {
      "name": "budget_used_usd",
      "unit": "USD"
    },
    {
      "name": "budget_remaining_usd",
      "unit": "USD"
    },
    {
      "name": "scenario_objective_value_usd",
      "unit": "declared USD objective"
    },
    {
      "name": "assets"
    },
    {
      "name": "implementation_checks"
    },
    {
      "name": "formal_claims"
    },
    {
      "name": "formal_scope"
    },
    {
      "name": "empirical_status"
    },
    {
      "name": "decision_lens"
    },
    {
      "name": "claim_boundary"
    },
    {
      "name": "allocated_capital_usd",
      "unit": "USD",
      "input_echo": true
    },
    {
      "name": "allocation_fraction",
      "unit": "fraction of full retrofit",
      "input_echo": true
    },
    {
      "name": "net_declared_benefit_usd",
      "unit": "declared USD objective",
      "input_echo": true
    }
  ],
  "hypotheses": [
    {
      "id": "budget_nonnegative",
      "statement": "The declared budget is non-negative.",
      "check": "budget_usd >= 0"
    },
    {
      "id": "alternatives_declared",
      "statement": "Every alternative has positive capital cost and friction and non-negative burdens.",
      "check": "len(assets) >= 1 and all(a['capital_cost_usd'] > 0 and a['transition_friction_usd'] > 0 and a['gross_avoided_value_usd'] >= 0 and a['embodied_transition_cost_usd'] >= 0 for a in assets)"
    },
    {
      "id": "distinct_alternatives",
      "statement": "Alternative identifiers are distinct.",
      "check": "len(sorted(a['asset_id'] for a in assets)) == len(assets)"
    }
  ],
